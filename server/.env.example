# ==============================================================================
# GYM MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# IMPORTANT:
# 1. Copy this file to '.env' in this directory:
#      cp .env.example .env
# 2. Fill in your own credentials below.
# 3. DO NOT COMMIT '.env' TO GITHUB OR ANY PUBLIC REPOSITORY!
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. MONGODB ATLAS DATABASE
# ------------------------------------------------------------------------------
# How to get your MongoDB Atlas URI:
# 1. Log in to https://cloud.mongodb.com
# 2. Select your Cluster -> Click 'Connect' -> 'Drivers' (Node.js).
# 3. Copy the connection string and replace <db_password> with your database user password.
# 4. Example format: mongodb+srv://username:password@cluster0.abcde.mongodb.net/gymdesk?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://aaryanjagga12_db_user:6R2SgwRYfGVDiIz6@apexfit.lztl1vj.mongodb.net/apexfit?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Generate a strong, secure random string for signing JSON Web Tokens.
# You can generate one via terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=PASTE_A_LONG_RANDOM_SECRET_HERE
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# How to get your Razorpay API Keys:
# 1. Log in to Razorpay Dashboard (https://dashboard.razorpay.com).
# 2. Go to 'Account & Settings' -> 'API Keys'.
# 3. Generate Key ID and Key Secret (use 'Test Mode' for development).
# 4. Paste them below.
RAZORPAY_KEY_ID=PASTE_YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=PASTE_YOUR_RAZORPAY_KEY_SECRET_HERE

# ------------------------------------------------------------------------------
# 5. FRONTEND & BACKEND URLS (CORS)
# ------------------------------------------------------------------------------
# The URL of your Vite React frontend (typically http://localhost:5173 during development):
CLIENT_URL=http://localhost:5173

# The URL of this Express backend API (typically http://localhost:5000 during development):
SERVER_URL=http://localhost:5000
